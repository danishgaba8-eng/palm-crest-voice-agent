RETELL_API_KEY=key_xxx
# Your Retell (or Twilio-imported) number, used by voice_agent.outbound
RETELL_FROM_NUMBER=+12025550100

# Option A (recommended): the Sheet's Apps Script web app, see apps_script/Code.gs
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
SHEETS_WEBHOOK_TOKEN=same-random-string-as-the-TOKEN-script-property

# Option B: a Google service account (leave SHEETS_WEBHOOK_URL empty to use this)
# GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# GOOGLE_SHEET_ID=1AbC...
# GOOGLE_SHEET_TAB=Calls

# Optional: leave blank to log SMS instead of sending
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

AGENCY_NAME=Palm Crest Realty
AGENCY_PHONE=
